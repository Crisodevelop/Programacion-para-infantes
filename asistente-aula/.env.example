# ─────────────────────────────────────────────────────────────────────────
#  Copia este archivo a .env.local y rellena los valores.
#  .env.local está en .gitignore: nunca debe llegar a un repositorio.
# ─────────────────────────────────────────────────────────────────────────

# Supabase · tu proyecto (Project Settings → API)
# Públicas: viajan al navegador a propósito. Quien decide qué puede leer cada
# quien es la RLS junto con la sesión, no la clave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service_role salta la RLS: jamás con prefijo NEXT_PUBLIC_. Solo la usan
# los scripts de `scripts/` que corres en tu Mac.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Token de administración, SOLO para aplicar migraciones (npm run db:migrar).
# La app en marcha no lo usa. Rótalo si alguna vez se expone.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Opcionales, solo para `npm run docente:crear`: el nombre de la cuenta y su
# contraseña (si no se pone, se genera una al azar).
ASISTENTE_DOCENTE_NOMBRE=
ASISTENTE_CLAVE=

# ─────────────────────────────────────────────────────────────────────────
#  EN VERCEL, SOLO ESTAS DOS:
#     NEXT_PUBLIC_SUPABASE_URL
#     NEXT_PUBLIC_SUPABASE_ANON_KEY
#
#  Ninguna otra. SUPABASE_SERVICE_ROLE_KEY y SUPABASE_ACCESS_TOKEN saltan
#  toda la RLS: no pueden aparecer en el despliegue.
# ─────────────────────────────────────────────────────────────────────────
